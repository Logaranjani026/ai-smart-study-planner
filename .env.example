# Flask Configuration
SECRET_KEY=change-this-to-a-secure-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=1

# MySQL Database Configuration
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=smart_study_planner

# Optional direct SQLAlchemy URI override (e.g. mysql+pymysql://user:pass@localhost:3306/smart_study_planner)
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/smart_study_planner

# Optional: Set to 1 only for offline/fallback SQLite testing when MySQL is unavailable
ALLOW_SQLITE_FALLBACK=0

